import fitz
import os
import glob

def smart_quality_converter(input_folder, output_base_folder, 
                           quality_level="high", zoom=2.0,
                           create_separate_folders=True):
    """
    Akıllı kalite seçici
    
    Args:
        quality_level: "low", "medium", "high", "ultra", "professional"
    """
    
    # Kalite seviyeleri
    quality_settings = {
        "low": {"dpi": 150, "desc": "Düşük kalite (hızlı)"},
        "medium": {"dpi": 200, "desc": "Orta kalite"},
        "high": {"dpi": 300, "desc": "Yüksek kalite (önerilen)"},
        "ultra": {"dpi": 400, "desc": "Ultra kalite"},
        "professional": {"dpi": 600, "desc": "Profesyonel kalite (yavaş)"}
    }
    
    if quality_level not in quality_settings:
        quality_level = "high"
    
    settings = quality_settings[quality_level]
    
    print(f"🎚️  Kalite seviyesi: {settings['desc']}")
    print(f"📊 DPI: {settings['dpi']}")
    
    pdf_files = glob.glob(os.path.join(input_folder, "*.pdf"))
    
    for pdf_path in pdf_files:
        pdf_filename = os.path.basename(pdf_path)
        pdf_name = os.path.splitext(pdf_filename)[0]
        
        output_folder = os.path.join(output_base_folder, pdf_name) if create_separate_folders else output_base_folder
        
        if not os.path.exists(output_folder):
            os.makedirs(output_folder)
        
        print(f"\n📄 İşleniyor: {pdf_filename} ({quality_level} kalite)")
        
        doc = fitz.open(pdf_path)
        
        for page_num in range(len(doc)):
            page = doc.load_page(page_num)
            
            mat = fitz.Matrix(zoom * (settings['dpi'] / 72), zoom * (settings['dpi'] / 72))
            pix = page.get_pixmap(matrix=mat)
            
            output_filename = f"{pdf_name}_S{page_num + 1}_{quality_level.upper()}.png"
            output_path = os.path.join(output_folder, output_filename)
            
            pix.save(output_path)
            
            if (page_num + 1) % 3 == 0:
                print(f"   📈 Sayfa {page_num + 1}: {pix.width}×{pix.height} px")
        
        doc.close()
        print(f"   ✅ Tamamlandı")

# Kullanım örnekleri
if __name__ == "__main__":
    # 1. YÜKSEK KALİTE (ÖNERİLEN)
    smart_quality_converter(
        input_folder=os.getcwd(),
        output_base_folder=os.path.join(os.getcwd(), "Output_High"),
        quality_level="high",  # 🏆 EN İYİ DENGE
        zoom=2.0,
        create_separate_folders=True
    )
    
    # 2. PROFESYONEL KALİTE (EN İYİ)
    smart_quality_converter(
        input_folder=os.getcwd(),
        output_base_folder=os.path.join(os.getcwd(), "Output_Pro"),
        quality_level="professional",  # 🎯 EN YÜKSEK KALİTE
        zoom=2.0,
        create_separate_folders=True
    )
