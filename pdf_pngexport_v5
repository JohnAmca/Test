def convert_pdfs_with_memory_optimization(settings):
    """
    Bellek optimizasyonlu PDF dönüştürme
    """
    input_folder = settings["input_folder"]
    output_folder = settings["output_folder"]
    dpi = settings["dpi"]
    zoom = settings["zoom"]
    create_separate_folders = settings["create_separate_folders"]
    
    # PDF dosyalarını bul
    pdf_files = glob.glob(os.path.join(input_folder, "*.pdf"))
    
    if not pdf_files:
        print("❌ PDF dosyası bulunamadı!")
        return
    
    print(f"\n📊 Bellek optimizasyonlu işlem başlıyor...")
    print(f"   📄 Toplam PDF: {len(pdf_files)}")
    print(f"   🎯 Kalite: {dpi} DPI")
    print(f"   🔍 Büyütme: %{zoom * 100}")
    print(f"   💾 Maksimum piksel: 40MP")
    print("=" * 50)
    
    # Çıktı klasörünü oluştur
    os.makedirs(output_folder, exist_ok=True)
    
    successful_conversions = 0
    total_pages_converted = 0
    
    for pdf_path in pdf_files:
        pdf_filename = os.path.basename(pdf_path)
        pdf_name = os.path.splitext(pdf_filename)[0]
        
        print(f"\n📄 İşleniyor: {pdf_filename}")
        
        # Bellek optimizasyonlu dönüştürme
        success = safe_pdf_conversion(
            pdf_path=pdf_path,
            output_folder=output_folder,
            pdf_name=pdf_name,
            dpi=dpi,
            zoom=zoom,
            create_separate_folders=create_separate_folders
        )
        
        if success:
            successful_conversions += 1
            doc = fitz.open(pdf_path)
            total_pages_converted += len(doc)
            doc.close()
            print(f"   🎉 {pdf_name} başarıyla tamamlandı")
        else:
            print(f"   ❌ {pdf_name} işlenemedi")
        
        # PDF'ler arası bellek temizliği
        import gc
        gc.collect()
    
    # Sonuç raporu
    print("\n" + "=" * 60)
    print("📊 İŞLEM TAMAMLANDI!")
    print("=" * 60)
    print(f"   ✅ Başarılı PDF: {successful_conversions}/{len(pdf_files)}")
    print(f"   🖼️  Dönüştürülen sayfa: {total_pages_converted}")
    print(f"   📂 Çıktı klasörü: {output_folder}")
    print("=" * 60)

def main():
    """
    Ana program - bellek optimizasyonlu
    """
    try:
        # Kullanıcı ayarlarını al
        settings = get_user_input()
        
        # Optimizasyon seçenekleri
        print("\n🔧 Bellek Optimizasyonu:")
        print("   [1] Otomatik optimizasyon (Önerilen)")
        print("   [2] Manuel ayarlar")
        
        opt_choice = input("   Seçiminiz (1-2): ").strip()
        
        if opt_choice == "2":
            print("   ⚠️  Manuel mod riskli olabilir!")
        
        # Dönüştürme işlemini başlat
        convert_pdfs_with_memory_optimization(settings)
        
        # Programı kapat
        input("\n⏹️  Çıkmak için Enter tuşuna basın...")
        
    except KeyboardInterrupt:
        print("\n❌ İşlem kullanıcı tarafından iptal edildi.")
    except Exception as e:
        print(f"\n❌ Beklenmeyen hata: {str(e)}")
        input("Çıkmak için Enter tuşuna basın...")

