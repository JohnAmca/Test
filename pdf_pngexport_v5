    # Bellek durumunu kontrol et
    memory_info = psutil.virtual_memory()
    print(f"💾 Sistem belleği: {memory_info.percent}% dolu")
    
    if memory_info.percent > 90:
        print("⚠️  Yüksek bellek kullanımı! Acil durum modu önerilir.")
