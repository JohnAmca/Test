import fitz  # PyMuPDF
import os
import glob
import sys
import psutil

def optimize_memory_usage():
    """Bellek kullanımını optimize et"""
    if psutil.virtual_memory().percent > 85:
        print("⚠️  Uyarı: Sistem belleği %85'in üzerinde!")
        return False
    return True

def safe_pdf_conversion(pdf_path, output_folder, pdf_name, dpi=300, zoom=2.0, 
                       create_separate_folders=True, max_pixels=40000000):
    """
    Bellek dostu PDF dönüştürme fonksiyonu
    max_pixels: 40MP (40000000) = yaklaşık 6325×6325 piksel
    """
    
    try:
        doc = fitz.open(pdf_path)
        total_pages = len(doc)
        
        for page_num in range(total_pages):
            # Bellek kontrolü
            if not optimize_memory_usage():
                print("   ⚠️  Bellek yetersiz, bekleniyor...")
                import time
                time.sleep(2)
            
            page = doc.load_page(page_num)
            
            # Sayfa boyutunu kontrol et
            rect = page.rect
            base_width = rect.width * (dpi / 72) * zoom
            base_height = rect.height * (dpi / 72) * zoom
            total_pixels = base_width * base_height
            
            # Çok büyük sayfalar için otomatik ölçeklendirme
            effective_dpi = dpi
            effective_zoom = zoom
            
            if total_pixels > max_pixels:
                # Otomatik ölçeklendirme faktörü hesapla
                scale_factor = (max_pixels / total_pixels) ** 0.5
                effective_zoom = zoom * scale_factor
                print(f"   ⚠️  Sayfa {page_num + 1} çok büyük, otomatik küçültülüyor: %{effective_zoom * 100:.1f}")
            
            # Optimize edilmiş matris
            mat = fitz.Matrix(effective_zoom * (effective_dpi / 72), 
                             effective_zoom * (effective_dpi / 72))
            
            try:
                # Düşük bellek kullanımlı pixmap
                pix = page.get_pixmap(
                    matrix=mat,
                    alpha=False,
                    colorspace="rgb",
                    annots=True
                )
                
                # Dosya adı
                output_filename = f"{pdf_name}_S{page_num + 1}.png"
                if create_separate_folders:
                    output_path = os.path.join(output_folder, pdf_name, output_filename)
                else:
                    output_path = os.path.join(output_folder, output_filename)
                
                # Klasörü kontrol et
                os.makedirs(os.path.dirname(output_path), exist_ok=True)
                
                # Kaydet
                pix.save(output_path)
                
                # Pixmap'i hemen temizle (bellek boşalt)
                del pix
                
                print(f"   ✅ Sayfa {page_num + 1}: {pix.width}×{pix.height} px")
                
            except MemoryError:
                print(f"   ❌ Sayfa {page_num + 1} bellek hatası - daha düşük kalite deneniyor...")
                
                # Daha düşük kalite ile tekrar dene
                mat = fitz.Matrix(1.0 * (150 / 72), 1.0 * (150 / 72))  # Düşük DPI
                pix = page.get_pixmap(matrix=mat)
                pix.save(output_path)
                print(f"   ⚠️  Sayfa {page_num + 1} düşük kalite kaydedildi")
                del pix
            
            # Sayfa başına garbage collection
            import gc
            gc.collect()
        
        doc.close()
        return True
        
    except Exception as e:
        print(f"   ❌ Kritik hata: {str(e)}")
        return False

